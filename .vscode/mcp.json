{
    "servers": {
        "sequential-thinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ]
        },
        "git": {
            "command": "uvx",
            "args": ["mcp-server-git"]
        },
        "jetbrains": {
            "command": "npx",
            "args": ["-y", "@jetbrains/mcp-proxy"]
        },
        "browsermcp": {
            "command": "npx",
            "args": ["@browsermcp/mcp@latest"]
        },

        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "F:/IntelliJ/ExtendedTerminal/ExtendedTerminal_1_21_1"
            ]
        }
    }
}