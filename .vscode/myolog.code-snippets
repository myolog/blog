{
    "blog slug": {
        "prefix" : ["blog slug"],
        "body": [
            "---",
            "import { getCollection, render, type CollectionEntry } from 'astro:content';",
            "",
            "export async function getStaticPaths() {",
	        "   const posts = await getCollection('${0:collection}');",
	        "   return posts.map((post) => ({",
		    "   params: { slug: post.id },",
		    "   props: post,",
	        "   }));",
            "}",
            "type Props = CollectionEntry<'${0:collection}'>;",
            "",
            "const post = Astro.props;",
            "const posts = await getCollection('_framework_astro');",
            "const { Content } = await render(post);",
            "---"
        ]
    }   
}