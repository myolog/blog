<div class="side-toc">
    <div class="side-toc-container">

    </div>
</div>

<style is:inline>
    .side-toc {
        position: fixed;
        top: 0;
        right: 0;
        width: 100px;
        height: 100vh;
        z-index: 11;
    }

    .side-toc-container {
        position: relative;
        width: 100%;
        height: 100%;
    }
    .side-toc-item {
        /* default: small dot, hidden text */
        position: absolute;
        width: 8px;
        height: 8px;
        right: 0;
        background-color: rgba(0, 0, 0, 0.5);
        border: none;
        border-radius: 50%;
        padding: 0;
        font-size: 0;
        color: white;
        text-decoration: none;
        overflow: hidden;
        transition: width 0.3s, padding 0.3s, font-size 0.3s, background-color 0.3s;
    }
    .side-toc-item:hover {
        /* expand and show text */
        width: auto;
        height: auto;
        padding: 0.5rem;
        font-size: 0.75rem;
        background-color: rgba(0, 0, 0, 0.7);
        border-radius: 1rem;
    }
</style>

<script>
    function load() {
        let hs = ["h1","h2","h3","h4","h5","h6"]
        let sidebar = document.querySelector(".side-toc-container") as HTMLDivElement
        let body = document.querySelector(".blog-body")!

        let siteHeight = window.innerHeight

        for(let h of hs) {
            let headers = document.querySelectorAll(`.blog-body ${h}`)

            for(let header of headers) {
                if (!header.id) {
                    continue
                }
                const bodyTop = body.getBoundingClientRect().top + window.scrollY
                const bodyBottom = body.getBoundingClientRect().bottom + window.scrollY
                const bodyHeight = bodyBottom - bodyTop
                const headerY = header.getBoundingClientRect().top + window.scrollY - bodyTop

                const topPercent = (headerY / bodyHeight) * 98

                console.log(bodyTop, bodyBottom, bodyHeight)

                console.log(`${header.id}: ${headerY}px`)
                
                // 요소 만듬
                const element = document.createElement("a");
                element.href = `#${header.id}`;
                element.textContent = header.textContent;
                element.classList.add(`toc-${h}`);
                element.classList.add(`side-toc-item`);
                element.style.top = `${topPercent}%`;
                //요소 이벤트
                element.addEventListener('click', (e) => {
                    e.preventDefault()

                    const targetHeader = document.getElementById(header.id)!;
                    const headerOffset = 100;
                    
                    const elementPosition = targetHeader.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                    
                    window.scrollTo({
                        top: offsetPosition,
                        behavior: "smooth"
                    });
                })

                // 요소 추가
                sidebar?.appendChild(element);
            }
            
        }
        sidebar.addEventListener("mouseenter", () => {
            
        })
    }

    function position() {
        let blogBody = document.querySelector(".blog-body")!

        let blogheight = blogBody.clientHeight
        let pageHeight = window.innerHeight
        
        console.log(blogheight,pageHeight)
    }

    document.addEventListener('astro:page-load', () => {
        load()
        position()
    })
</script>