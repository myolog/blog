<div class="side-toc">
    <div class="side-toc-container">

    </div>
</div>

<style is:inline>
    .side-toc {
        position: fixed;
        top: 0;
        right: 0;
        width: 100px;
        height: 100vh;
        z-index: 11;
    }

    .side-toc-container {
        position: relative;
        width: 100%;
        height: 100%;
    }
    .side-toc-item {
        position: absolute;
        width:max-content;
        right: 0;
        color: white;
        text-decoration: none;
        display: block;

        background-color: black;
        padding: 0.5rem;
        border: solid gray 1px;
        border-radius: 1rem;

        &:hover {
            color: white !important;
        }
    }
</style>

<script>
    function load() {

        let hs = ["h1","h2","h3","h4","h5","h6"]
        let sidebar = document.querySelector(".side-toc-container")
        for(let h of hs) {
            let headers = document.querySelectorAll(`.blog-body ${h}`)

            for(let header of headers) {
                if (!header.id) {
                    continue
                }
                
                const element = document.createElement("a");
                element.href = `#${header.id}`;
                element.textContent = header.textContent;
                element.classList.add(`toc-${h}`);
                element.classList.add(`side-toc-item`);

                element.addEventListener('click', (e) => {
                    e.preventDefault()

                    const targetHeader = document.getElementById(header.id)!;
                    const headerOffset = 100;
                    
                    const elementPosition = targetHeader.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                    
                    window.scrollTo({
                        top: offsetPosition,
                        behavior: "smooth"
                    });
                })

                sidebar?.appendChild(element);
            }
            
        }
        
    }

    function position() {
        let blogBody = document.querySelector(".blog-body")!

        let blogheight = blogBody.clientHeight
        let pageHeight = window.innerHeight
        
        console.log(blogheight,pageHeight)
    }

    document.addEventListener('astro:page-load', () => {
        load()
        position()
    })
</script>