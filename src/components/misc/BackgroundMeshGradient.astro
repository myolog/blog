<canvas id="canvas-mesh-gradient"></canvas>

<style>
	:root {
		--c-top-left: 173,216,230;
		--c-top-right: 186,85,211;
		--c-bottom-left: 255,250,205;
		--c-bottom-right: 255,192,203;
	}
	#canvas-mesh-gradient {
		z-index: -100;
		top: 0;
		left: 0;
		position: fixed;
		width: calc(100% + 100px);
		height: calc(100% + 100px);
		transform: translate(-50px, -50px);
		overflow: hidden;
		filter: blur(1rem);
		/* Replace JS drawing with CSS gradients */
		background:
			radial-gradient(
				circle at top left,
				rgb(var(--c-top-left)) 0%,
				transparent 70%
			),
			radial-gradient(
				circle at top right,
				rgb(var(--c-top-right)) 0%,
				transparent 70%
			),
			radial-gradient(
				circle at bottom left,
				rgb(var(--c-bottom-left)) 0%,
				transparent 70%
			),
			radial-gradient(
				circle at bottom right,
				rgb(var(--c-bottom-right)) 0%,
				transparent 70%
			);
		background-blend-mode: screen;
	}
</style>
