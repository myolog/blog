---
import SearchModal from "../components/search/SearchModal.astro"

import "../styles/global.css"
import "../styles/searchModal.css"

import type { Props as SeoProps } from "astro-seo"
import Footer from "../components/section/Footer.astro";
import Header from "../components/section/Header.astro";
import { SEO } from "astro-seo";
import BackgroundMeshGradient from "../components/misc/BackgroundMeshGradient.astro";

import { ClientRouter } from 'astro:transitions';

interface BaseLayoutProps {
    seo: SeoProps
}


const { seo } = Astro.props as BaseLayoutProps

---
<html lang="ko" transition:name="root" transition:animate="none">
    <head>
        <SEO {...seo} charset="utf-8"/>
        <ClientRouter/>
    </head>
    <Header/>
    <body>
        <main>
            <SearchModal/>
            <div class="modal-blur-overlay">
                <slot/>
            </div>
        </main>
    </body>
    <Footer/>
    <BackgroundMeshGradient/>
</html>