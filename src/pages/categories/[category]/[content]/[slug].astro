---
import { render } from "astro:content";
import { Main } from "@myolog/layouts";
import { MyoSEO } from "@myolog/libs/astro";
import { PostDetail } from "@myolog/components/post";
import { Breadcrumb } from "@myolog/components/breadcrumb";
import { MyoStaticPath } from "@myolog/libs/server";

import "../../../../styles/callout.css"
import "../../../../styles/utterance.css"

export async function getStaticPaths() {
    return MyoStaticPath.slugStaticPath();
}

const { title, heroImage } = Astro.props.data;

const { Content } = await render(Astro.props);
---

<Main seo={MyoSEO.BlogSEO(Astro.props.data)}>
	<Breadcrumb title={title} />
	<PostDetail
		{...Astro.props.data}
		category={Astro.props.data.tags[0]}
		headings={Astro.props.rendered?.metadata?.headings!}
	>
		<Content />
	</PostDetail>

</Main>
