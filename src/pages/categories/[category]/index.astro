---
import { Breadcrumb } from '@myolog/components/breadcrumb';
import { CategoryHeader } from '@myolog/components/category';
import { Main } from '@myolog/layouts';
import { MyoCollection, MyoStaticPaths } from "@myolog/libs/astro"
import { Badge } from '@myolog/components/common';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import { Post, PostView } from '@myolog/components/post';
import type { CollectionKey } from 'astro:content';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
    return MyoStaticPaths.categoryStaticPath()
}


const { category } = Astro.params
const { description, icon, childs, articleCount } = Astro.props

const contents = MyoCollection.categories[category].contents

type Post = Awaited<ReturnType<typeof getCollection>>[number]

const postsByContent: Record<string, Post[]> = {}


await Promise.all(
  contents.map(async (contentName) => {
    const allPosts = await getCollection(`categories/${category}/${contentName}` as CollectionKey)
    postsByContent[contentName] = allPosts.sort((a,b) => b.data.publishTime - a.data.publishTime).slice(0,3)
  })
)

---

<Main seo={{ title: `묘로그 - ${category}`}}>
    <Breadcrumb/>
    <CategoryHeader title={category} description={description!} icon={icon!} articleLength={articleCount} />
    {Object.keys(postsByContent).map(x => <div>
        <div class="flex gap-2 flex-row items-center mb-4">
            <Badge title={x} size="small"/>
            <hr class="flex-1">
            <a href={`/categories/${category}/${x}`} class="flex gap-2 flex-row">
              See more
              <Icon name="lucide:arrow-right" class="self-center"/>
            </a>
        </div>
        <PostView>
            {postsByContent[x].map(p => <Post {...p.data} href={`/categories/${category}/${x}/${p.id}`} category={p.data.tags[0]}/>)}
        </PostView>
    </div>)}
</Main>
