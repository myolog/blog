---
import { Breadcrumb } from '@myolog/components/breadcrumb';
import { Category, CategoryHeader } from '@myolog/components/category';
import { Main } from '@myolog/layouts';
import { MyoUrl } from '@myolog/libs';
import { Categories, type CategoryType } from '@myolog/markdown';
import { Icon } from 'astro-icon/components';
import { Toggle } from "@myolog/components/common"
import { MyoCollection, MyoStaticPaths } from "@myolog/libs/blog"
import { Collections } from "@myolog/markdown"
import { PostView, Post } from '@myolog/components/post';
export function getStaticPaths() {
    return MyoStaticPaths.getStaticPaths()
    return [
        { params: { category: "framework" },
            props: { ...Categories.instance.categoryData["framework"] }},
        { params: { category: "modding" },
            props: { ...Categories.instance.categoryData["modding"] }}
    ]
}


const { category } = Astro.params
const { description, icon, childs, articleCount } = Astro.props
const url = MyoUrl.of(Astro.request.url)
const subCategories = ["all", ...childs]


const collection = new MyoCollection(category as CategoryType)
const posts = await collection.getCollections()

---

<Main seo={{ title: `묘로그 - ${category}`}}>
    <Breadcrumb/>
    <CategoryHeader title={category} description={description!} icon={icon!} articleLength={articleCount} />
    <div class="flex gap-3 items-center flex-row mb-6" id="subcategory-group">
        <Icon name='lucide:tag'/>
        {subCategories.map(x => <Toggle aria-label={x}>{x}</Toggle>)}
    </div>

    <PostView>
        {posts.map(x => <Post href={`../${x.collection}/${x.id}`} {...x.data} imageUrl={x.data.heroImage} date={x.data.pubDate.toISOString()}/>)}
    </PostView>

</Main>

<script>
    const group = document.querySelector("#subcategory-group")!
    
    group.querySelectorAll("button")

</script>
