---
import { Main } from "@myolog/layouts";
import { type CollectionEntry, getCollection, render } from "astro:content";


export const getStaticPaths = (async () => {
    const posts = await getCollection("categories/framework/astro")
    return posts.map((post: CollectionEntry<"categories/framework/astro">) => ({
        params: { slug: post.id },
        props: post
    }))
})

const post = Astro.props
const { Content } = await render(post);
---

<Main seo={{}}>
    <Content/>
</Main>

