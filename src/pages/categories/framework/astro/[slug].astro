---
import { Main } from "@myolog/layouts";
import { MyoSEO } from "@myolog/libs/blog"
import { type BlogProps } from "@myolog/markdown"; 
import { type CollectionEntry, getCollection, render } from "astro:content";

export const getStaticPaths = (async () => {
    const posts = await getCollection("categories/framework/astro")
    return posts.map((post: CollectionEntry<"categories/framework/astro">) => ({
        params: { slug: post.id },
        props: post
    }))
})

const post = Astro.props
const { Content } = await render(post);
const seo = MyoSEO.BlogSEO(post.data as BlogProps)
---

<Main seo={seo}>
    <Content/>
</Main>

