---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

import { Main } from "@myolog/layouts";
import { HeroSection } from "@myolog/layouts/section";
import { MyoUrl } from "@myolog/libs";
import { Post, PostView } from "@myolog/components/post";
import { Breadcrumb } from "@myolog/components/breadcrumb";

const posts = await getCollection("categories/framework/astro")

const url = MyoUrl.of(Astro.request.url)

---

<Main>
    <Breadcrumb/>
    <PostView>
        {posts.map(x => (
        <Post href={`${url}/${x.id}`} title={x.data.title} date="2025-05-23" readTime="10 min" excerpt="aa" category={x.data.tags.at(0) ?? ""} imageUrl={x.data.heroImage}/>))}
    </PostView>

</Main>