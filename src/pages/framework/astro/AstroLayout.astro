---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb/Breadcrumb.astro";
import "../../../styles/Blog/blog-template.css"
import "../framework.css"
import FluentIEmoji from "../../../components/misc/FluentIEmoji.astro";
const { seo } = Astro.props;
---

<BaseLayout seo={seo} transition:name="astro-blog">
    <img class="framework-icon" src="/framework/astro/icon.svg" transition:persist="astro">
    <Breadcrumb/>
    <slot/>
</BaseLayout>