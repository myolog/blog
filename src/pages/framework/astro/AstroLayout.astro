---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb/Breadcrumb.astro";
import "../../../styles/Blog/blog-template.css"
import "../../../styles/framework.css"
import "../../../styles/Blog/callout.css"
const { seo } = Astro.props;

---

<BaseLayout seo={seo} transition:name="astro-blog">
    <img class="framework-icon" src="/icon/framework/astro/icon.svg" transition:persist="astro">
    <Breadcrumb/>
    <slot/>
</BaseLayout>