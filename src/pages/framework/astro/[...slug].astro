---
import { type CollectionEntry, getCollection } from "astro:content";
import AstroLayout from "./AstroLayout.astro";
import { render } from "astro:content";
import { type Props as SeoProps } from "astro-seo";

import Card from "../../../components/Card/Card.astro";
import CardView from "../../../components/Card/CardView.astro";
import SideHeader from "../../../components/SideHeader.astro";

export async function getStaticPaths() {
	const posts = await getCollection('_framework_astro');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'_framework_astro'>;

const post = Astro.props;
const posts = await getCollection('_framework_astro');
const { Content } = await render(post);

const seo: SeoProps = {
	title: post.data.title,
	description: post.data.description,
	twitter: {
		image: post.data.heroImage,
		imageAlt: post.data.title,
	},
};

const url = Astro.request.url.split("/").slice(0, -1).join("/");
---

<AstroLayout seo={seo}>
	<SideHeader/>
	<div class="blog-container">
		<h1 class="blog-title">{post.data.title}</h1>
		<p class="blog-pubdate">{post.data.pubDate.toLocaleDateString()}</p>
		<p class="blog-description">{post.data.description}</p>
		<div
			class="blog-body"
			transition:name="astro-blog"
			transition:animate="fade"
		>
			<Content />
		</div>

		<script src="https://utteranc.es/client.js"
			repo="myolog/myolog-reply"
			issue-term="pathname"
			theme="github-light"
			crossorigin="anonymous"
			async>
		</script>

		<CardView style="margin-top: 2rem">
			{
				posts.map((x) => {
					return (
						<Card
							url={`${url}/${x.id}`}
							title={x.data.title}
							description={x.data.description}
							heroImage={x.data.heroImage}
						/>
					);
				})
			}
		</CardView>
	</div>
</AstroLayout>

<style>
	.blog-description {
		font-size: 1.1rem;
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
		font-style: italic;
		line-height: 1.5;
		max-width: 90%;
	}
</style>
