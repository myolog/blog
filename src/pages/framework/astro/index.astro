---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb/Breadcrumb.astro";
import CardView from "../../../components/Card/CardView.astro";
import Card from "../../../components/Card/Card.astro";


// 목록 블러오기
const posts = await getCollection('framework_astro');
posts.map((post) => ({
    params: { slug: post.id },
    props: post,
}));

const url = Astro.request.url;

---

<BaseLayout seo={{title: "Framework Astro"}}>
    <Breadcrumb/>
    <img src="/framework/astro/icon.svg" alt="Astro Logo" width="100"/>
    <CardView>
        {posts.map((post) => (
            <Card url={`${url}/${post.id}`} title={post.data.title} description={post.data.description} heroImage={post.data.heroImage}/>
        ))}
    </CardView>
</BaseLayout>