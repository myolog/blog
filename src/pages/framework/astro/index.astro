---
import { getCollection } from "astro:content";
import CardView from "../../../components/Card/CardView.astro";
import Card from "../../../components/Card/Card.astro";
import AstroLayout from "./AstroLayout.astro";


// 목록 블러오기
const posts = await getCollection('_framework_astro');
posts.map((post) => ({
    params: { slug: post.id },
    props: post,
}));

const url = Astro.request.url;

---

<AstroLayout seo={{title: "Framework Astro"}}>
    <CardView>
        {posts.map((post) => (
            <Card url={`${url}/${post.id}`} title={post.data.title} description={post.data.description} heroImage={post.data.heroImage}/>
        ))}
    </CardView>
</AstroLayout>