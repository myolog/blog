---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AstroLayout from "./AstroLayout.astro";


// 목록 블러오기
const posts = await getCollection('framework_astro');
posts.map((post) => ({
    params: { slug: post.id },
    props: post,
}));


---

<BaseLayout seo={{title: "Framework Astro"}}>
    <h1>Framework Astro</h1>
    {posts.map((post) => (
        <a href={`./astro/${post.id}`}>{post.data.title}</a><br/>
    ))}
</BaseLayout>