---
import { RootLayout } from "@myolog/layouts";
import { Collections } from "@myolog/markdown";
import { FrameworkCard, CardView } from "@myolog/components/card";

import { Breadcrumb } from "@myolog/components/breadcrumb";
---

<RootLayout seo={{ title: "묘로그 - 프레임워크" }}>
	<Breadcrumb containLastUrl />
	<div class="container">
		<h1>프레임 워크</h1>
		<hr />
		<CardView>
			{
				Collections.values
					.filter((v) => v.category() === "framework")
					.map((value) => (
						<FrameworkCard
							href={`/${value.name}`}
							blogName={value.name}
              tags={value.tags()}
						/>
					))
			}
		</CardView>
	</div>
</RootLayout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	h1 {
		font-size: 2rem;
		font-weight: bold;
		margin-bottom: 1.5rem;
	}
</style>
