---
import { getCollection } from "astro:content";
import AstroLayout from "../astro/AstroLayout.astro";
import Card from "../../../components/Card/Card.astro";
import CardView from "../../../components/Card/CardView.astro";


const posts = await getCollection('_framework_minecraft');
posts.map((post) => ({
    params: { slug: post.id },
    props: post,
}));

---

<AstroLayout>
    <CardView>
        {posts.map(x => (<Card url={`./minecraft/${x.id}`} {...x.data} />))}
    </CardView>

</AstroLayout>