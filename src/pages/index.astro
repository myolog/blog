---
import { Main } from "@myolog/layouts";
import { SideSection, HeroSection } from "@myolog/layouts/section";
import { getCollection, type CollectionKey } from "astro:content";
import { Post } from "@myolog/components/post";
import { CollectionData } from "@myolog/markdown/data";
import { MyoMath }  from "@myolog/libs"
const collectionKey = MyoMath.pickRandom(CollectionData.values)?.name as CollectionKey
const collections = await getCollection(collectionKey);
---

<Main seo={{ title: "묘로그" }}>
	<HeroSection
		title="Welcome to Myolog"
		subtitle={"Discover articles, tutorials, and insights about modern web development, programming languages, and software engineering best practices."}
	/>
	<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
		<div class="lg:col-span-2">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{
					collections.map((x: any, i: number) => (
						<Post
							featured={i === 0}
							title={x.data.title}
							description={x.data.description}
							heroImage={x.data.heroImage}
							category={x.data.tags[0]}
							publishTime={x.data.publishTime}
							href={`/${collectionKey}/${x.id}`}
						/>
					))
				}
			</div>
		</div>
		<SideSection />
	</div>
</Main>
