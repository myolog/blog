---
import { type CollectionEntry, getCollection } from "astro:content";
import { render } from "astro:content";
import { type Props as SeoProps } from "astro-seo";

import {Card, CardView } from "@myolog/components/card";
import {AstroPageLayout} from "@myolog/layouts/content";

const posts = await getCollection('framework/astro')

export async function getStaticPaths() {
	const posts = await getCollection('framework/astro');
	return posts.map((post: any) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'framework/astro'>;

const post = Astro.props;
const { Content } = await render(post);

const seo: SeoProps = {
	title: post.data.title,
	description: post.data.description,
	twitter: {
		image: post.data.heroImage,
		imageAlt: post.data.title,
	},
};

const url = Astro.request.url.split("/").slice(0, -1).join("/");
---

<AstroPageLayout seo={seo}>
	<div class="blog-container">
		<h1 class="blog-title">{post.data.title}</h1>
		<p class="blog-pubdate">{post.data.pubDate.toLocaleDateString()}</p>
		<p class="blog-description">{post.data.description}</p>
		<div
			class="blog-body"
			transition:name="astro-blog"
			transition:animate="fade"
		>
			<Content />
		</div>

		<script src="https://utteranc.es/client.js"
			repo="myolog/myolog-reply"
			issue-term="pathname"
			theme="github-light"
			crossorigin="anonymous"
			async>
		</script>

			{
				posts.map((x: Props) => {
					return (
						<Card
							href={`${url}/${x.id}`}
							title={x.data.title}
							excerpt={x.data.description}
							imageUrl={x.data.heroImage}
							category="a"
							readTime="2"
							date=""
						/>
					);
				})
			}
	</div>
</AstroPageLayout>

<style>
	.blog-description {
		font-size: 1.1rem;
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
		font-style: italic;
		line-height: 1.5;
		max-width: 90%;
	}
</style>
