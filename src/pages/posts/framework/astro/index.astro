---
import { getCollection, type CollectionEntry } from "astro:content";
import { Card, CardView } from "@myolog/components/card";
import { Post } from "@myolog/components/post"
import {AstroPageLayout} from "@myolog/layouts/content";

type Props = CollectionEntry<'framework/astro'>;

// 목록 블러오기
const posts = await getCollection('framework/astro');

posts.map((post: Props) => ({
    params: { slug: post.id },
    props: post,
}));

const url = Astro.request.url;

---

<AstroPageLayout seo={{title: "묘로그 - Astro"}}>
    <CardView>
        {posts.map((post: Props) => (
            <Post href={`${url}/${post.id}`} title={post.data.title} excerpt={post.data.description} imageUrl={post.data.heroImage}/>
        ))}
    </CardView>
</AstroPageLayout>