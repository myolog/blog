---
import { RootLayout } from "@myolog/layouts";
import { Collections } from "@myolog/markdown";

import { MyoUrl } from "@myolog/libs";
const url = MyoUrl.of(Astro.request.url);
---

<RootLayout seo={{ title: "묘로그 - 프레임워크" }}>
	
	<div class="container">
		<h1>프레임 워크</h1>
		<hr />
			{
				Collections.values
					.filter((v) => v.category() === "framework")
					.map((value) => (
						<>{value.name}</>
					))
			}
	</div>
</RootLayout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	h1 {
		font-size: 2rem;
		font-weight: bold;
		margin-bottom: 1.5rem;
	}
</style>
