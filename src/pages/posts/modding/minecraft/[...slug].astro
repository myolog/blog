---
import { getCollection, render, type CollectionEntry } from "astro:content";
import {RootLayout} from "@myolog/layouts";


export async function getStaticPaths() {
	const posts = await getCollection('framework/minecraft');
	return posts.map((post: Props) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'framework/minecraft'>

const post = Astro.props;
const { Content } = await render(post);

---
<RootLayout>
	<Content/>
</RootLayout>